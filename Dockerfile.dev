# Development image for the Vite dev server and Storybook; source is bind-mounted.
FROM node:22-bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends git \
    && rm -rf /var/lib/apt/lists/*
# Shared control package, linked by package.json as file:../brain-control.
COPY --from=brain-control . /brain-control
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci
EXPOSE 5178 6006
CMD ["npm", "run", "dev", "--", "--host", "0.0.0.0"]
