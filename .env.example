# Host port for the web UI (published on 127.0.0.1 only).
AUDIOBRAIN_WEB_PORT=5178
# Where outgoing OSC UDP is sent. host.docker.internal reaches the Docker host.
OSC_TARGET_HOST=host.docker.internal
OSC_TARGET_PORT=9000
# Comma-separated exact browser origins allowed to open the gateway WebSocket.
OSC_ALLOWED_ORIGINS=http://127.0.0.1:5178,http://localhost:5178
