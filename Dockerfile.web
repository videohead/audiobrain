# AudioBrain local static web app: production Vite bundle served by nginx.
FROM node:22-bookworm-slim AS build
# Shared control package, linked by package.json as file:../brain-control.
COPY --from=brain-control . /brain-control
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci
COPY . .
RUN npm run build

FROM nginx:1.27-alpine
COPY --from=build /app/dist /usr/share/nginx/html
EXPOSE 80
